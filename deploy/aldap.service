[Unit]
Description=ALDAP - LDAP proxy with virtual directory and brute-force protection
Documentation=https://github.com/aldap/aldap
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/aldap run --config /etc/aldap/aldap.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStopSec=45s

# Identity & credentials
DynamicUser=yes
# Each secret becomes ${CREDENTIALS_DIRECTORY}/<name>; reference it in aldap.toml as
#   bind_password_file = "${CREDENTIALS_DIRECTORY}/ad_pass"
LoadCredential=ad_pass:/etc/aldap/secrets/ad_pass
LoadCredential=virola_bind:/etc/aldap/secrets/virola_bind
LoadCredential=api_admin:/etc/aldap/secrets/api_admin
Environment=ALDAP_CONFIG=/etc/aldap/aldap.toml

# Filesystem
RuntimeDirectory=aldap
RuntimeDirectoryMode=0700
StateDirectory=aldap
ConfigurationDirectory=aldap
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# Privileges
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
